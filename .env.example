# SharveshMart environment template.
# Copy this file to `src/main/resources/config.properties` (gitignored) and fill
# in values, OR export these variables in the environment. Environment variables
# always take precedence over the properties file.
#
#   Windows (PowerShell):  $env:DB_URL="jdbc:h2:file:./data/sharvesh_mart"
#   Linux (bash):          export DB_URL="jdbc:h2:file:./data/sharvesh_mart"

# JDBC URL for H2.
# Local development (embedded file mode):
#   DB_URL=jdbc:h2:file:./data/sharvesh_mart
# Deployed (H2 server mode, spec Section 10):
#   DB_URL=jdbc:h2:tcp://localhost:9092/./data/sharvesh_mart
DB_URL=jdbc:h2:file:./data/sharvesh_mart

# H2 credentials (server mode only; the embedded file mode ignores the password).
DB_USER=sa
DB_PASSWORD=

# Connection pool size (HikariCP).
DB_POOL_SIZE=10

# Set to true to re-run schema.sql and seed.sql on startup, wiping existing data.
DB_RESET_ON_STARTUP=false

# AI chatbot provider (Phase 3): gemini | mock
AI_CHATBOT_PROVIDER=mock
