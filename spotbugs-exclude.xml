<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      SHARVESHMART SpotBugs exclusions.
      Mirrors the required engineering rules; benign findings that do not affect
      security or correctness in a servlet/webapp context are excluded here and
      documented in the final report.
    -->
    <Match>
        <!-- DTOs expose primitives / String fields via getters by design. -->
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <!-- Session ID regeneration is handled by invalidating the old session. -->
        <Bug pattern="J2EE_STORE_OF_NON_SERIALIZABLE_OBJECT_INTO_SESSION"/>
    </Match>
    <Match>
        <!-- Servlets are container-managed singletons and are never serialized. -->
        <Class name="com.sharvesh.sharvesh_mart.controller.DispatcherServlet"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <Match>
        <!-- The DataSource is owned by the ServletContextListener per spec; storing it in the context is required. -->
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>
    <Match>
        <!-- Random UUIDs are only used for request correlation IDs (not security). -->
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
</FindBugsFilter>
