<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SharveshMart</display-name>

    <!-- Owns the HikariCP pool lifecycle (spec Section 2). -->
    <listener>
        <listener-class>com.saranya.saranyamart.listener.AppContextListener</listener-class>
    </listener>

    <!-- Explicit session timeout (spec Section 4 rule 3). -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Filter order: request id, encoding, then auth. -->
    <filter>
        <filter-name>requestIdFilter</filter-name>
        <filter-class>com.saranya.saranyamart.filter.RequestIdFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>requestIdFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.saranya.saranyamart.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.saranya.saranyamart.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Front Controller (spec Section 2). -->
    <servlet>
        <servlet-name>dispatcherServlet</servlet-name>
        <servlet-class>com.saranya.saranyamart.controller.DispatcherServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcherServlet</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>

    <!-- Custom error pages must not expose stack traces (spec Section 9). -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

</web-app>
