# SharveshMart Frontend - Environment template
# For local split dev: point to backend API
# For Railway: set BACKEND_URL in dashboard (frontend service -> Variables)
# Example: BACKEND_URL=https://sharveshmart-backend.up.railway.app
BACKEND_URL=http://localhost:8080
# Or for same-origin monolith (when backend serves static), leave empty:
# BACKEND_URL=
